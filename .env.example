RAG_DATA_DIR=./data
RAG_HOST=127.0.0.1
RAG_PORT=8080
RAG_INLINE_JOBS=true

# Local model endpoints. Docker Model Runner or a native llama.cpp server can
# implement these interfaces; the application does not depend on Ollama.
RAG_EMBEDDING_PROVIDER=deterministic
RAG_EMBEDDING_BASE_URL=
RAG_EMBEDDING_MODEL=
RAG_RERANK_PROVIDER=http
RAG_RERANK_ENDPOINT=http://localhost:12434/rerank
RAG_RERANK_MODEL=ai/qwen3-reranker:0.6B

# Evidence set is built before the gate and reused unchanged for generation.
# The score floor applies to single-hop only; multi-hop retains reranker Top 6.
RAG_EVIDENCE_SINGLE_HOP_LIMIT=4
RAG_EVIDENCE_MULTI_HOP_LIMIT=6

# External grounded answer/planning model. Put the real key in a repository-
# external secret file or process environment, never in this file.
RAG_LLM_ENABLED=false
RAG_LLM_BASE_URL=https://api.deepseek.com
RAG_LLM_MODEL=deepseek-v4-flash
RAG_LLM_API_KEY=
