RAG_DATA_DIR=./data
RAG_HOST=127.0.0.1
RAG_PORT=8080
RAG_INLINE_JOBS=true

# Local model endpoints. Docker Model Runner or a native llama.cpp server can
# implement these interfaces; the application does not depend on Ollama.
RAG_EMBEDDING_PROVIDER=deterministic
RAG_EMBEDDING_BASE_URL=
RAG_EMBEDDING_MODEL=
RAG_RERANK_PROVIDER=http
RAG_RERANK_ENDPOINT=http://localhost:12434/rerank
RAG_RERANK_MODEL=ai/qwen3-reranker:0.6B

# Immutable index defaults. Auto keeps exact cosine for fewer than 100k chunks
# and builds a persisted USearch HNSW index at/above that boundary. Both are
# selectable per index build from Web UI or REST.
RAG_DENSE_DEFAULT_BACKEND=auto
RAG_DENSE_AUTO_HNSW_MIN_CHUNKS=100000
RAG_HNSW_CONNECTIVITY=32
RAG_HNSW_EXPANSION_ADD=512
RAG_HNSW_EXPANSION_SEARCH=512

# Auto preserves meaningful Markdown/DOCX structure and applies local
# embedding-based semantic breakpoints to long generic TXT/PDF sections.
RAG_CHUNK_DEFAULT_STRATEGY=auto
RAG_CHUNK_TARGET_CHARS=1100
RAG_CHUNK_OVERLAP_CHARS=160
RAG_SEMANTIC_BREAKPOINT_PERCENTILE=90
RAG_SEMANTIC_MIN_CHARS=320
RAG_SEMANTIC_MAX_CHARS=1600
RAG_RETRIEVAL_QUERY_CONCURRENCY=2
RAG_CONVERSATION_MEMORY_TURNS=5

# Evidence set is built before the gate and reused unchanged for generation.
# The score floor applies to single-hop only; multi-hop retains reranker Top 6.
RAG_EVIDENCE_SINGLE_HOP_LIMIT=4
RAG_EVIDENCE_MULTI_HOP_LIMIT=6

# External grounded answer/planning model. Put the real key in a repository-
# external secret file or process environment, never in this file.
RAG_LLM_ENABLED=false
RAG_LLM_BASE_URL=https://api.deepseek.com
RAG_LLM_MODEL=deepseek-v4-flash
RAG_LLM_API_KEY=
